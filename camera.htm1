<h1>Camera Security Lab</h1>
<p>Лабораторная работа по кибербезопасности</p>

<button onclick="startCamera()">
    Включить камеру
</button>

<button onclick="stopCamera()">
    Выключить камеру
</button>

<p id="status">Статус: камера выключена</p>

<video id="camera" width="320" autoplay playsinline></video>

<script>
    let stream = null;

    async function startCamera() {
        try {
            stream = await navigator.mediaDevices.getUserMedia({
                video: true,
                audio: false
            });

            document.getElementById("camera").srcObject = stream;

            document.getElementById("status").textContent =
                "Статус: камера включена";

        } catch (error) {
            document.getElementById("status").textContent =
                "Доступ запрещён: " + error.message;
        }
    }

    function stopCamera() {
        if (stream) {
            stream.getTracks().forEach(track => track.stop());
            stream = null;
        }

        document.getElementById("camera").srcObject = null;

        document.getElementById("status").textContent =
            "Статус: камера выключена";
    }
</script>
